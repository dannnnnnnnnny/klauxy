{
  "name": "klauxy",
  "version": "0.1.0",
  "description": "Transparent Korean-to-English prompt translation for Claude Code",
  "type": "module",
  "bin": {
    "klx": "./dist/index.js",
    "klauxy": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "biome check src",
    "format": "biome format --write src"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@iarna/toml": "2.2.5",
    "node-pty": "1.2.0-beta.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/node": "22.12.0",
    "typescript": "5.6.3",
    "vitest": "4.1.7"
  }
}
