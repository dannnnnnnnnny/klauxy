{
  "name": "klauxy",
  "version": "0.1.0",
  "description": "Transparent Korean-to-English prompt translation for Claude Code",
  "type": "module",
  "bin": {
    "klx": "./dist/index.js",
    "klauxy": "./dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dannnnnnnnnny/klauxy.git"
  },
  "homepage": "https://github.com/dannnnnnnnnny/klauxy#readme",
  "bugs": {
    "url": "https://github.com/dannnnnnnnnny/klauxy/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "korean",
    "translation",
    "proxy",
    "ollama",
    "mlx"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run check && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "biome check src",
    "verify:package": "node scripts/verify-package.mjs",
    "formula:update": "node scripts/update-formula.mjs",
    "format": "biome format --write src"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@iarna/toml": "2.2.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/node": "22.12.0",
    "typescript": "5.6.3",
    "vitest": "4.1.7"
  }
}
